<resources>
    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/black</item>
    </style>

    <!--自定义样式风格-->
    <style name="MyTabStyle">
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:drawablePadding">1dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">@color/selector_text_color</item>
        <item name="android:background">@color/bg</item>
    </style>

    <style name="CustomTabRadioButton" parent="Widget.AppCompat.CompoundButton.RadioButton">
        <!-- 1. 去掉默认的 RadioButton 圆点 -->
        <item name="android:button">@null</item>

        <!-- 2. 设置文字在图标下方 (top|center_horizontal) -->
        <item name="android:gravity">center_horizontal|bottom</item>

        <!-- 3. 设置图标在文字上方，需要配合代码或布局中的 compoundDrawable 设置 -->
        <!-- 4. 设置内边距，让点击区域更大 -->
        <item name="android:padding">12dp</item>

        <!-- 5. 设置背景点击效果 (可选，这里设置为透明) -->
        <item name="android:background">@android:color/transparent</item>

        <!-- 6. 文字颜色使用 State List，实现变色效果 -->
        <item name="android:textColor">@color/selector_text_color</item>

        <!-- 7. 字体大小 -->
        <item name="android:textSize">14sp</item>
    </style>
</resources>